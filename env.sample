# ============================================================
# Zimbra 9 Zimlet Testbed — single source of truth
# Change names here; everything else derives from these.
# ============================================================

# --- Hostnames & domain ------------------------------------
ZIMBRA_HOST=zimbra.lan
IDP_HOST=idp.lan
MAIL_DOMAIN=example.local

# --- Network (fixed subnet; must match docker-compose.yml) -
SUBNET=10.9.0.0/24
DNS_IP=10.9.0.2
ZIMBRA_IP=10.9.0.3
IDP_IP=10.9.0.4
SP_IP=10.9.0.5

# --- Zimbra ------------------------------------------------
ZIMBRA_ADMIN_PASSWORD=Zimbra2021
ZIMBRA_IMAGE=iwayvietnam/zimbra_all:latest

# --- IdP ---------------------------------------------------
# Static test users. Format: email:password (comma separated).
# The email IS the IdP username.
IDP_USERS=alice@example.local:alice-pass,bob@example.local:bob-pass,ghost@example.local:ghost-pass
IDP_ADMIN_PASSWORD=idp-admin-pass

# Which of the IdP users get a real Zimbra mailbox (comma-separated emails).
# Users in IDP_USERS but NOT here are used for the negative SSO test
# (valid IdP login, no Zimbra account -> must be rejected).
ZIMBRA_MAILBOXES=alice@example.local,bob@example.local

# --- Host port mapping (change if host ports clash) --------
ZIMBRA_HTTP_PORT=8081
# Public webmail URL port — served by the SAML SP proxy (zt-sp), not Zimbra.
ZIMBRA_HTTPS_PORT=8444
IDP_HTTPS_PORT=8445
IMAPS_PORT=1093
POP3S_PORT=1095
